---
import '../styles/global.css';
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 min-h-screen">
		<slot />
	</body>
</html>